<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,user-scalable=no">
<meta name="theme-color" content="#0e0c0a">
<meta name="apple-mobile-web-app-capable" content="yes">
<title>始信音乐 · 调音器</title>
<style>
  :root{
    --bg:#0a0a0a;
    --surface:#161616;
    --surface-2:#1f1f1f;
    --surface-3:#2b2b2b;
    --border:rgba(240,235,227,.06);
    --border-2:rgba(240,235,227,.10);
    --text:#f0f0f0;
    --text-2:#909090;
    --text-3:#5e5e5e;

    /* 主题色（由 tools/ui_tool.py 生成）*/
    --accent:#a0a0a0;
    --accent-light:#bababa;
    --accent-soft:rgba(160,160,160,.13);
    --accent-rgb:160,160,160;
    --accent-light-rgb:186,186,186;

    --success:#7fc87f;
    --success-rgb:127,200,127;
    --warn:#dcb050;
    --warn-rgb:220,176,80;
  }
  *{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
  html,body{margin:0;padding:0;min-height:100%;height:100%}
  body{
    min-height:100dvh;
    display:flex;align-items:stretch;justify-content:center;
    padding:0;
    background:var(--bg);
    background-image:
      radial-gradient(ellipse 90% 55% at 50% -8%, rgba(var(--accent-rgb),.07), transparent 62%),
      radial-gradient(ellipse 70% 45% at 50% 108%, rgba(var(--accent-rgb),.035), transparent 70%);
    color:var(--text);
    font-family:-apple-system,BlinkMacSystemFont,"SF Pro Display","SF Pro Text","PingFang SC","Helvetica Neue","Microsoft YaHei",sans-serif;
    -webkit-font-smoothing:antialiased;
    text-rendering:optimizeLegibility;
    user-select:none;
    font-weight:400;
    letter-spacing:.005em;
    overflow-x:hidden;
  }

  .app{
    width:100%;
    max-width:100%;
    min-height:100dvh;
    position:relative;
    background:var(--surface);
    border:0;
    border-radius:0;
    padding:calc(22px + env(safe-area-inset-top)) 22px calc(22px + env(safe-area-inset-bottom));
    display:flex;
    flex-direction:column;
    box-shadow:none;
    overflow:hidden;
  }
  /* 大屏幕时回到居中卡片 */
  @media (min-width: 520px){
    body{padding:20px;align-items:center}
    .app{
      max-width:460px;
      min-height:calc(100dvh - 40px);
      border:1px solid var(--border);
      border-radius:26px;
      padding:26px 22px 24px;
      box-shadow:
        0 20px 50px rgba(0,0,0,.5),
        inset 0 1px 0 rgba(240,235,227,.04);
    }
  }

  /* ============ 顶部 ============ */
  .header{
    display:flex;align-items:center;justify-content:space-between;
    gap:12px;margin-bottom:22px;flex:none;
  }
  .brand{display:flex;align-items:center;gap:11px;min-width:0}
  .brand-mark{width:34px;height:34px;flex:none}
  .brand-text{display:flex;flex-direction:column;gap:4px}
  .brand-cn{
    font-size:15px;font-weight:500;line-height:1;
    letter-spacing:.16em;color:var(--text);
  }
  .brand-en{
    font-size:8.5px;font-weight:500;line-height:1;
    letter-spacing:.34em;color:var(--text-3);
  }

  .header-right{display:flex;align-items:center;gap:12px;flex:none}

  .mic{
    display:flex;align-items:center;gap:6px;
    font-size:11px;font-weight:500;color:var(--text-3);
    letter-spacing:.02em;
  }
  .mic .dot{
    width:6px;height:6px;border-radius:50%;
    background:#3d3830;transition:all .3s;
  }
  .mic.on .dot{background:var(--success);box-shadow:0 0 6px var(--success)}
  .mic.on{color:#b8d4a4}

  .settings-btn{
    appearance:none;border:0;background:transparent;
    color:var(--text-2);cursor:pointer;
    width:34px;height:34px;border-radius:9px;
    display:flex;align-items:center;justify-content:center;
    transition:all .2s;
    padding:0;
  }
  .settings-btn:active{background:var(--surface-3);transform:scale(.94)}
  .settings-btn.active{color:var(--accent);background:var(--accent-soft)}
  .settings-btn svg{
    width:18px;height:18px;
    transition:transform .3s ease;
  }
  .settings-btn.active svg{transform:rotate(60deg)}

  /* ============ 设置面板 ============ */
  .settings-panel{
    max-height:0;overflow:hidden;
    transition:max-height .35s cubic-bezier(.4,0,.2,1), margin .35s, opacity .3s;
    opacity:0;
    margin-bottom:0;
    flex:none;
  }
  .settings-panel.open{
    max-height:220px;
    opacity:1;
    margin-bottom:18px;
  }
  .settings-inner{
    background:var(--surface-2);
    border:1px solid var(--border);
    border-radius:14px;
    padding:4px 14px;
  }
  .setting-row{
    display:flex;align-items:center;justify-content:space-between;
    padding:12px 0;gap:10px;
  }
  .setting-row + .setting-row{border-top:1px solid var(--border)}
  .setting-label{
    font-size:12.5px;font-weight:500;color:var(--text-2);
    letter-spacing:.02em;
  }

  .a4-control{
    display:flex;align-items:center;gap:0;
    background:var(--surface-3);border-radius:10px;
    padding:2px;
  }
  .a4-btn{
    appearance:none;border:0;background:transparent;
    color:var(--text-2);font-size:15px;font-weight:500;
    width:30px;height:30px;border-radius:7px;cursor:pointer;
    font-family:inherit;line-height:1;
    display:flex;align-items:center;justify-content:center;
    transition:all .15s;
  }
  .a4-btn:active{background:rgba(240,235,227,.08);color:var(--text)}
  .a4-value{
    font-size:12.5px;font-weight:500;color:var(--text);
    font-variant-numeric:tabular-nums;
    letter-spacing:.01em;
    padding:0 10px;
    min-width:68px;text-align:center;
  }
  .a4-value .unit{
    font-size:10px;color:var(--text-3);margin-left:2px;
  }

  .view-toggle{
    display:flex;background:var(--surface-3);
    border-radius:10px;padding:2px;gap:2px;
  }
  .view-btn{
    appearance:none;border:0;background:transparent;
    color:var(--text-2);font-family:inherit;
    font-size:11.5px;font-weight:500;
    padding:6px 14px;border-radius:8px;cursor:pointer;
    letter-spacing:.02em;transition:all .2s;
  }
  .view-btn.active{
    background:var(--surface);
    color:var(--text);
    box-shadow:0 1px 3px rgba(0,0,0,.3);
  }

  /* ============ 模式标签 ============ */
  .mode-tabs{
    display:flex;background:var(--surface-2);
    border:1px solid var(--border);
    border-radius:12px;padding:3px;gap:2px;
    margin-bottom:20px;flex:none;
  }
  .mode-tab{
    flex:1;appearance:none;border:0;background:transparent;
    color:var(--text-3);font-family:inherit;
    font-size:13px;font-weight:500;
    padding:11px 4px;border-radius:9px;cursor:pointer;
    transition:all .22s;letter-spacing:.04em;
  }
  .mode-tab:active{transform:scale(.97)}
  .mode-tab.active{
    background:var(--surface-3);
    color:var(--text);
  }

  /* ============ 中间区域（可变高） ============ */
  .center{
    flex:1 1 auto;
    display:flex;flex-direction:column;
    justify-content:center;
    min-height:0;
    margin-bottom:8px;
  }

  /* ============ 表盘区（含音名） ============ */
  .gauge-block{
    position:relative;
    width:100%;
    margin:0 auto;
  }
  .gauge-svg{
    display:block;width:100%;height:auto;overflow:visible;
  }
  #needleDot{
    transition:cx .08s linear, cy .08s linear, fill .25s, r .25s;
  }
  .app.tuning-ok #needleDot{ fill:var(--success); }
  .app.tuning-ok .gauge-arc{ stroke:rgba(var(--success-rgb),.38); }

  /* 音名叠层 */
  .gauge-overlay{
    position:absolute;
    left:0;right:0;
    top:58%;
    transform:translateY(-50%);
    display:flex;flex-direction:column;
    align-items:center;justify-content:center;
    pointer-events:none;
    text-align:center;
  }
  .note{
    font-weight:500;line-height:1;
    letter-spacing:-.02em;
    color:var(--text);
    transition:color .3s;
    font-variant-numeric:tabular-nums;
    display:flex;align-items:baseline;justify-content:center;
  }
  .note .letter{font-size:72px;letter-spacing:-.04em}
  .note .oct{
    font-size:24px;font-weight:400;
    color:var(--text-2);
    margin-left:6px;
    letter-spacing:0;
  }
  .app.tuning-ok .note{color:var(--success)}
  .app.tuning-ok .note .oct{color:var(--success);opacity:.7}

  .cents{
    margin-top:12px;
    font-size:15px;font-weight:500;
    letter-spacing:.04em;
    color:var(--text-3);
    transition:color .3s;
    min-height:20px;
    font-variant-numeric:tabular-nums;
  }
  .cents.high{color:var(--warn)}
  .cents.low{color:var(--warn)}
  .cents.ok{color:var(--success)}

  .freq-line{
    position:absolute;
    left:0;right:0;bottom:-6px;
    text-align:center;
    font-size:11.5px;font-weight:400;
    color:var(--text-3);
    letter-spacing:.1em;
    font-variant-numeric:tabular-nums;
    min-height:16px;
    opacity:.7;
  }

  /* 音量条 */
  .level-row{
    display:flex;align-items:center;gap:12px;
    margin:14px 0 18px;flex:none;
  }
  .level-label{
    font-size:9.5px;font-weight:500;color:var(--text-3);
    letter-spacing:.2em;flex:none;
  }
  .level-bar{
    flex:1;height:3px;background:var(--surface-3);
    border-radius:2px;overflow:hidden;
  }
  .level-fill{
    height:100%;width:0%;
    background:var(--text-2);border-radius:2px;
    transition:width .14s linear;
  }

  /* 频闪视图 */
  .strobe-view{display:none}
  .strobe-view.show{display:block}
  .gauge-block.hide{display:none}
  #strobeCanvas{
    display:block;width:100%;height:220px;
    border-radius:14px;
    background:var(--surface-2);
    border:1px solid var(--border);
  }

  /* ============ 弦按钮 ============ */
  .target-area{margin:0 0 20px;flex:none}
  .strings{display:grid;gap:7px}
  .strings.guitar{grid-template-columns:repeat(6,1fr)}
  .strings.ukulele{grid-template-columns:repeat(4,1fr)}
  .sbtn{
    appearance:none;cursor:pointer;font-family:inherit;
    border:1px solid var(--border);
    background:transparent;
    border-radius:13px;
    padding:16px 2px 15px;
    display:flex;flex-direction:column;align-items:center;gap:5px;
    transition:all .22s ease;
  }
  .sbtn:active{transform:scale(.96)}
  .sbtn .num{
    font-size:10px;font-weight:500;color:var(--text-3);
    letter-spacing:.04em;line-height:1;
  }
  .sbtn .nm{
    font-size:19px;font-weight:500;line-height:1;
    color:var(--text-2);transition:color .22s;
    letter-spacing:.01em;
  }
  .sbtn.active{
    border-color:rgba(var(--accent-rgb),.5);
    background:var(--accent-soft);
  }
  .sbtn.active .nm{color:var(--text)}
  .sbtn.active .num{color:rgba(var(--accent-rgb),.75)}

  .sbtn.in-tune{
    border-color:rgba(var(--success-rgb),.5);
    background:rgba(var(--success-rgb),.08);
  }
  .sbtn.in-tune .nm{color:var(--success)}
  .sbtn.in-tune .num{color:rgba(var(--success-rgb),.75)}

  /* 钢琴 */
  .piano-area{display:none}
  .piano-area.show{display:block}
  .octave-row{
    display:flex;align-items:center;justify-content:center;
    gap:16px;margin-bottom:14px;
  }
  .oct-btn{
    width:40px;height:36px;border-radius:10px;
    border:1px solid var(--border);
    background:transparent;
    color:var(--text-2);font-size:14px;font-weight:500;
    cursor:pointer;transition:all .15s;
    display:flex;align-items:center;justify-content:center;
    font-family:inherit;
  }
  .oct-btn:active{transform:scale(.94);background:var(--surface-3)}
  .oct-btn:disabled{opacity:.25;cursor:not-allowed}
  .oct-display{
    min-width:78px;text-align:center;
    font-size:14px;font-weight:500;color:var(--text);
    letter-spacing:.08em;font-variant-numeric:tabular-nums;
    padding:7px 14px;border-radius:9px;
    background:var(--surface-2);
    border:1px solid var(--border);
  }
  .piano-keys{display:grid;grid-template-columns:repeat(6,1fr);gap:6px}
  .pkey{
    appearance:none;cursor:pointer;font-family:inherit;
    border:1px solid var(--border);
    background:var(--surface-2);
    color:var(--text-2);
    font-size:12px;font-weight:500;
    padding:14px 2px;border-radius:10px;
    transition:all .15s;letter-spacing:.01em;
  }
  .pkey.black{
    background:var(--surface);
    color:var(--text-3);
  }
  .pkey:active{transform:scale(.96)}
  .pkey.active{
    background:var(--accent-soft);
    border-color:rgba(var(--accent-rgb),.5);
    color:var(--text);
  }
  .pkey.in-tune{
    background:rgba(var(--success-rgb),.08);
    border-color:rgba(var(--success-rgb),.5);
    color:var(--success);
  }

  /* ============ 主按钮 ============ */
  .start{
    width:100%;appearance:none;border:0;cursor:pointer;
    font-family:inherit;
    padding:18px;border-radius:14px;
    font-size:15px;font-weight:500;
    letter-spacing:.14em;
    color:#1a1410;
    background:linear-gradient(180deg, var(--accent-light), var(--accent));
    box-shadow:
      0 1px 0 rgba(255,255,255,.25) inset,
      0 4px 14px rgba(var(--accent-rgb),.15);
    transition:all .2s;
    flex:none;
  }
  .start:active{transform:scale(.99);filter:brightness(.95)}
  .start.stop{
    background:transparent;
    color:var(--text-2);
    border:1px solid var(--border-2);
    box-shadow:none;
  }
  .start:disabled{opacity:.5;cursor:wait}

  .hint{
    text-align:center;
    font-size:11px;font-weight:400;
    color:var(--text-3);
    margin-top:14px;
    letter-spacing:.04em;
    line-height:1.6;
    flex:none;
  }
  .hint b{color:var(--text-2);font-weight:500}

  /* 小屏高度时压缩 */
  @media (max-height:700px){
    .note .letter{font-size:60px}
    .note .oct{font-size:20px}
    .header{margin-bottom:16px}
    .mode-tabs{margin-bottom:16px}
    .target-area{margin-bottom:16px}
    .sbtn{padding:13px 2px 12px}
    .sbtn .nm{font-size:17px}
    .start{padding:16px}
    #strobeCanvas{height:180px}
  }

  /* ===== 手机 App 下载入口（由 tools/build_web.py 自动插入） ===== */
  .app-install-link{
    display:inline-flex;align-items:center;
    font-size:12px;font-weight:500;letter-spacing:.02em;
    color:var(--accent);text-decoration:none;
    padding:6px 13px;border-radius:8px;
    background:var(--accent-soft);
    transition:transform .18s ease,background .18s ease;
    white-space:nowrap;
  }
  .app-install-link:active{transform:scale(.95);background:rgba(var(--accent-rgb),.22)}

  /* METRO-BLOCK:CSS */
  /* ══════════════════════════════════════════════════════
     节拍器样式（由 tools/add_metronome.py 插入）
     ══════════════════════════════════════════════════════ */

  /* ── 顶部切换键：胶囊滑块 ──
     朴素切换：只有背景位移和颜色变化，不做缩放/抖动 */
  .app-tabs{
    position:relative;flex:none;
    display:flex;
    background:var(--surface-2);
    border-radius:9px;
    padding:3px;
    margin-left:13px;
  }
  .app-tabs-thumb{
    position:absolute;
    top:3px;left:3px;
    width:calc(50% - 3px);
    height:calc(100% - 6px);
    border-radius:7px;
    background:var(--surface-3);
    transition:transform .22s cubic-bezier(.4,0,.2,1);
    pointer-events:none;
  }
  .app-tabs[data-index="1"] .app-tabs-thumb{
    transform:translateX(100%);
  }
  .app-tab{
    position:relative;z-index:1;
    appearance:none;border:0;background:transparent;
    color:var(--text-3);
    font-family:inherit;font-size:12px;font-weight:500;
    letter-spacing:.06em;
    padding:6px 14px;border-radius:7px;cursor:pointer;
    transition:color .2s;
    -webkit-tap-highlight-color:transparent;
    min-width:52px;
  }
  .app-tab.active{ color:var(--text) }

  /* 页面容器 */
  .page{display:none;flex-direction:column;flex:1;min-height:0}
  .page.active{display:flex}

  /* 切换页时的显示差异 */
  body[data-page="metro"] .mic{display:none}
  body[data-page="metro"] .setting-row:not(#appRow){display:none}

  /* ══════════════════════════════════════════════════════
     节拍器
     ══════════════════════════════════════════════════════ */
  .metro-wrap{
    display:flex;flex-direction:column;flex:1;
    min-height:0;
  }

  /* ── 顶部：拍号选择器（右对齐）── */
  .metro-top{
    display:flex;justify-content:flex-end;
    flex:none;margin-bottom:6px;
  }
  .meter-btn{
    appearance:none;border:1px solid var(--border-2);
    background:var(--surface-2);
    color:var(--text);
    font-family:inherit;font-size:14px;font-weight:500;
    letter-spacing:.04em;
    padding:8px 12px 8px 14px;border-radius:10px;
    cursor:pointer;
    display:flex;align-items:center;gap:7px;
    transition:background .18s, border-color .18s;
    -webkit-tap-highlight-color:transparent;
    font-variant-numeric:tabular-nums;
  }
  .meter-btn:active{ background:var(--surface-3) }
  .meter-btn .chev{
    width:9px;height:9px;flex:none;
    opacity:.55;
  }
  .meter-btn .chev path{
    stroke:currentColor;stroke-width:2;
    fill:none;stroke-linecap:round;stroke-linejoin:round;
  }

  /* ── 圆环调速区 ── */
  .metro-ring-area{
    flex:1;
    display:flex;align-items:center;justify-content:center;
    min-height:0;
    position:relative;
    overflow:hidden;
  }
  .metro-ring{
    position:relative;
    height:100%;
    max-height:310px;          /* 比之前大，让内容不挤 */
    aspect-ratio:1;
    max-width:100%;
    display:flex;align-items:center;justify-content:center;
    touch-action:none;          /* 拖动时不要触发页面滚动 */
    cursor:grab;
    -webkit-tap-highlight-color:transparent;
  }
  .metro-ring:active{ cursor:grabbing }
  .metro-ring svg{
    position:absolute;inset:0;width:100%;height:100%;
    overflow:visible;
  }

  /* 底圈：暗色轨道 */
  .ring-track{
    fill:none;
    stroke:var(--surface-3);
    stroke-width:2;
    stroke-linecap:round;
  }
  /* 进度弧：显示当前 BPM 在范围内的位置 */
  .ring-progress{
    fill:none;
    stroke:var(--accent);
    stroke-width:3;
    stroke-linecap:round;
    opacity:.5;
    transition:stroke-dashoffset .1s linear;
  }
  /* 脉冲环：每拍扩散 */
  .pulse-ring{
    fill:none;
    stroke:var(--accent);
    stroke-width:1.5;
    opacity:0;
    transform-box:fill-box;
    transform-origin:center;
  }
  .pulse-ring.beat{
    animation:metroPulse .44s cubic-bezier(.22,.61,.36,1);
  }
  @keyframes metroPulse{
    0%   { opacity:.7; transform:scale(.68) }
    100% { opacity:0;  transform:scale(1.02) }
  }

  /* ── 圆心：数字 + 术语 ──
     数字约占圆环直径的 1/3 */
  .ring-center{
    position:relative;z-index:1;
    display:flex;flex-direction:column;
    align-items:center;justify-content:center;
    width:80%;                  /* 限制在圆内 */
    pointer-events:none;        /* 空白处让拖动/点击穿透到圆环 */
  }

  /* 数字：占圆环直径的 1/3 以上，可点击输入 */
  .ring-bpm{
    pointer-events:auto;
    appearance:none;border:0;background:transparent;
    font-family:inherit;
    font-size:105px;font-weight:300;
    line-height:.92;
    color:var(--text);
    letter-spacing:-.03em;
    font-variant-numeric:tabular-nums;
    padding:6px 16px;
    border-radius:16px;
    cursor:text;
    transition:color .2s, background .16s;
    -webkit-tap-highlight-color:transparent;
  }
  .ring-bpm:active{ background:var(--surface-2) }
  .ring-bpm.hidden{ display:none }
  /* 播放中：数字变主色 */
  .ring-bpm.playing{ color:var(--accent) }

  /* 输入框：尺寸跟数字一致，避免跳动。
     宽度用 100%：自动跟随圆环大小，不会在大屏太宽、小屏溢出 */
  .ring-bpm-input{
    display:none;
    pointer-events:auto;
    font-family:inherit;
    font-size:105px;font-weight:300;
    line-height:.92;
    color:var(--accent);
    background:var(--surface-2);
    border:2px solid var(--accent);
    border-radius:16px;
    width:100%;
    box-sizing:border-box;
    text-align:center;
    padding:6px 4px;
    outline:none;
    letter-spacing:-.03em;
    font-variant-numeric:tabular-nums;
    -webkit-appearance:none;
  }
  .ring-bpm-input.show{ display:block }

  .ring-term{
    font-size:13px;
    color:var(--text-3);
    letter-spacing:.08em;
    margin-top:8px;
    min-height:18px;
    transition:color .2s;
  }
  /* 播放中术语也跟着亮一点 */
  .ring-center.playing .ring-term{ color:var(--accent); opacity:.75 }

  /* ── 拍点指示 ── */
  .beat-dots{
    display:flex;justify-content:center;align-items:center;
    gap:8px;flex:none;
    height:22px;
    margin-top:4px;
  }
  .beat-dot{
    width:8px;height:8px;border-radius:50%;
    background:var(--surface-3);
    transition:background .1s, transform .1s;
  }
  .beat-dot.accent{ width:10px;height:10px }
  .beat-dot.on{
    background:var(--accent);
    transform:scale(1.4);
  }
  /* 拍子多的时候（比如 12/8）缩小一点，避免挤成一片 */
  .beat-dots.dense{ gap:5px }
  .beat-dots.dense .beat-dot{ width:6px;height:6px }
  .beat-dots.dense .beat-dot.accent{ width:7.5px;height:7.5px }
  .beat-dots.dense .beat-dot.on{ transform:scale(1.5) }

  /* ══════════════════════════════════════════════════════
     拍号选择面板（底部弹出）
     ══════════════════════════════════════════════════════ */
  .meter-sheet{
    position:fixed;inset:0;
    z-index:80;
    display:flex;align-items:flex-end;justify-content:center;
    background:rgba(0,0,0,.5);
    opacity:0;pointer-events:none;
    transition:opacity .22s;
  }
  .meter-sheet.open{
    opacity:1;pointer-events:auto;
  }
  .meter-sheet-body{
    width:100%;max-width:460px;
    background:var(--surface);
    border-top-left-radius:20px;
    border-top-right-radius:20px;
    padding:18px 20px calc(18px + env(safe-area-inset-bottom));
    transform:translateY(18px);
    transition:transform .24s cubic-bezier(.4,0,.2,1);
    border:1px solid var(--border-2);
    border-bottom:0;
  }
  .meter-sheet.open .meter-sheet-body{
    transform:translateY(0);
  }
  .meter-sheet-head{
    display:flex;align-items:center;justify-content:space-between;
    margin-bottom:16px;
  }
  .meter-sheet-title{
    font-size:14px;font-weight:500;color:var(--text);
    letter-spacing:.08em;
  }
  .meter-sheet-close{
    appearance:none;border:0;background:transparent;
    color:var(--accent);
    font-family:inherit;font-size:14px;font-weight:500;
    padding:6px 4px;cursor:pointer;
    letter-spacing:.04em;
    -webkit-tap-highlight-color:transparent;
  }

  .meter-sheet-cols{
    display:flex;gap:18px;
  }
  .meter-col{ flex:1;min-width:0 }
  .meter-col:last-child{ flex:0 0 42% }
  .meter-col-title{
    font-size:10.5px;color:var(--text-3);
    letter-spacing:.14em;
    margin-bottom:9px;
  }
  .meter-grid{
    display:grid;
    gap:6px;
  }
  #numGrid{ grid-template-columns:repeat(4, 1fr) }
  #denGrid{ grid-template-columns:repeat(3, 1fr) }
  .meter-item{
    appearance:none;
    border:1px solid transparent;
    background:var(--surface-2);
    color:var(--text-3);
    font-family:inherit;
    font-size:14px;font-weight:500;
    padding:11px 0;border-radius:10px;
    cursor:pointer;
    transition:background .16s, color .16s, border-color .16s;
    -webkit-tap-highlight-color:transparent;
    font-variant-numeric:tabular-nums;
  }
  .meter-item.active{
    background:var(--surface-3);
    border-color:var(--accent);
    color:var(--text);
  }

  /* ── 小屏适配 ──
     数字保持占圆环直径的 1/3 左右；
     极矮屏再压一级，避免内容和圆环挤在一起。 */
  @media (max-height: 780px){
    .metro-ring{ max-height:265px }
    .ring-bpm{ font-size:90px;padding:5px 14px }
    .ring-bpm-input{ font-size:90px;padding:5px 4px }
    .ring-term{ font-size:12px;margin-top:6px }
    .meter-btn{ font-size:13px;padding:7px 11px 7px 13px }
    .beat-dots{ height:19px;gap:6px }
    .beat-dot{ width:7px;height:7px }
    .beat-dot.accent{ width:9px;height:9px }
  }
  @media (max-height: 660px){
    .metro-ring{ max-height:210px }
    .ring-bpm{ font-size:71px;padding:4px 12px }
    .ring-bpm-input{ font-size:71px;padding:4px 3px }
    .ring-term{ font-size:11px;margin-top:4px;min-height:15px }
    .ring-center{ width:74% }
  }
  @media (max-height: 560px){
    .metro-ring{ max-height:160px }
    .ring-bpm{ font-size:54px;padding:3px 10px }
    .ring-bpm-input{ font-size:54px;padding:3px 2px }
    .ring-term{ font-size:10px;margin-top:3px;min-height:13px }
    .ring-center{ width:72% }
  }
  /* 极矮屏（横屏、老设备）：一切从简 */
  @media (max-height: 430px){
    .metro-wrap{ gap:6px }
    .metro-top{ margin-bottom:3px }
    .meter-btn{ font-size:12px;padding:5px 9px 5px 11px }
    .metro-ring{ max-height:132px }
    .ring-bpm{ font-size:45px;padding:2px 8px;border-radius:10px }
    .ring-bpm-input{ font-size:45px;padding:2px 2px;border-radius:10px }
    .ring-term{ font-size:9px;margin-top:2px;min-height:12px }
    .ring-center{ width:70% }
    .beat-dots{ height:16px;gap:5px;margin-top:2px }
    .beat-dot{ width:6px;height:6px }
    .beat-dot.accent{ width:7px;height:7px }
  }
  /* /METRO-BLOCK:CSS */
</style>
<!-- ===== PWA / 手机 App（由 tools/build_web.py 自动插入） ===== -->
<link rel="manifest" href="/manifest.webmanifest">
<link rel="icon" type="image/png" sizes="64x64" href="/icons/favicon.png">
<link rel="apple-touch-icon" sizes="192x192" href="/icons/icon-192.png">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="始信音乐">
<meta name="mobile-web-app-capable" content="yes">
<meta name="description" content="始信音乐 · 手机调音器：吉他、尤克里里、钢琴调音，精准快速，支持离线使用。">
<meta property="og:type" content="website">
<meta property="og:title" content="始信音乐 · 调音器">
<meta property="og:description" content="精准的手机调音器，支持吉他与尤克里里。">
<meta property="og:image" content="/icons/icon-512.png">
</head>
<body>

<div class="app" id="app">

  <div class="header">
    <div class="brand">
      <svg class="brand-mark" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="始信音乐">
        <defs>
          <linearGradient id="brandGrad" x1="4" y1="4" x2="28" y2="28" gradientUnits="userSpaceOnUse">
            <stop offset="0%" style="stop-color:var(--accent-light)"/>
            <stop offset="100%" style="stop-color:var(--accent)"/>
          </linearGradient>
        </defs>
        <circle cx="16" cy="16" r="14.25" stroke="url(#brandGrad)" stroke-width="1.5" fill="none"/>
        <rect x="9.5"  y="15" width="2.2" height="6.5" rx="1.1" fill="url(#brandGrad)" opacity=".5"/>
        <rect x="14.9" y="10.5" width="2.2" height="11" rx="1.1" fill="url(#brandGrad)"/>
        <rect x="20.3" y="13" width="2.2" height="8.5" rx="1.1" fill="url(#brandGrad)" opacity=".7"/>
      </svg>
      <div class="brand-text">
        <div class="brand-cn">始信音乐</div>
        <div class="brand-en">SHIXIN MUSIC</div>
      </div>
    </div>
<!-- METRO-BLOCK:HEADER -->
    <!-- 调音 / 节拍 切换（由 tools/add_metronome.py 插入） -->
    <div class="app-tabs" id="appTabs" role="tablist">
      <span class="app-tabs-thumb" id="tabThumb"></span>
      <button class="app-tab active" id="tabTuner" type="button" role="tab">调音</button>
      <button class="app-tab" id="tabMetro" type="button" role="tab">节拍</button>
    </div>
    <!-- /METRO-BLOCK:HEADER -->

    <div class="header-right">
      <div class="mic" id="micStatus"><span class="dot"></span><span id="micText">未启动</span></div>
      <button class="settings-btn" id="settingsBtn" type="button" aria-label="设置">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="3"/>
          <path d="M12 2.5v2M12 19.5v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2.5 12h2M19.5 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
        </svg>
      </button>
    </div>
  </div>

  <div class="settings-panel" id="settingsPanel">
    <div class="settings-inner">
      <div class="setting-row">
        <span class="setting-label">标准音高</span>
        <div class="a4-control">
          <button class="a4-btn" id="a4Down" type="button">−</button>
          <span class="a4-value" id="a4Value">440<span class="unit">Hz</span></span>
          <button class="a4-btn" id="a4Up" type="button">+</button>
        </div>
      </div>
      <div class="setting-row">
        <span class="setting-label">视图</span>
        <div class="view-toggle" id="viewToggle">
          <button class="view-btn active" data-view="needle">指针</button>
          <button class="view-btn" data-view="strobe">频闪</button>
        </div>
      </div>
      <div class="setting-row" id="appRow">
        <span class="setting-label">手机 App</span>
        <a class="app-install-link" href="/download/">下载安装</a>
      </div>
    </div>
  </div>

  <div class="page active" id="pageTuner">

  <div class="mode-tabs" id="modeTabs">
    <button class="mode-tab active" data-mode="guitar">吉他</button>
    <button class="mode-tab" data-mode="ukulele">尤克里里</button>
    <button class="mode-tab" data-mode="piano">钢琴</button>
  </div>

  <!-- 中间区域：表盘 + 音量 -->
  <div class="center">
    <div class="gauge-block" id="gaugeBlock">
      <svg class="gauge-svg" viewBox="0 0 400 240" xmlns="http://www.w3.org/2000/svg">
        <!-- 主弧 -->
        <path class="gauge-arc"
              d="M 101 111 A 140 140 0 0 1 299 111"
              fill="none" stroke="rgba(240,235,227,.10)"
              stroke-width="1.5" stroke-linecap="round"/>
        <!-- 准音区 -->
        <path d="M 189 70.43 A 140 140 0 0 1 211 70.43"
              fill="none" stroke="rgba(var(--success-rgb),.5)"
              stroke-width="2.5" stroke-linecap="round"/>
        <!-- 刻度 -->
        <g id="ticks"></g>
        <!-- 滑动圆点 -->
        <circle id="needleDot" cx="200" cy="70" r="6"
                style="fill:var(--accent)" stroke="none"/>
      </svg>

      <!-- 音名叠层 -->
      <div class="gauge-overlay">
        <div class="note" id="noteName"><span class="letter">–</span></div>
        <div class="cents" id="centsText">点击开始</div>
      </div>

      <div class="freq-line" id="freqText"></div>
    </div>

    <div class="strobe-view" id="strobeView">
      <canvas id="strobeCanvas"></canvas>
    </div>

    <div class="level-row">
      <span class="level-label">音量</span>
      <div class="level-bar"><div class="level-fill" id="levelFill"></div></div>
    </div>
  </div>

  <div class="target-area">
    <div class="strings guitar" id="stringsEl"></div>
    <div class="piano-area" id="pianoArea">
      <div class="octave-row">
        <button class="oct-btn" id="octDown" type="button">◀</button>
        <div class="oct-display"><span id="octValue">C4</span></div>
        <button class="oct-btn" id="octUp" type="button">▶</button>
      </div>
      <div class="piano-keys" id="pianoKeys"></div>
    </div>
  </div>

  <button class="start" id="startBtn">开始调音</button>
  <div class="hint" id="hintText">拨响琴弦即可 · 点琴弦按钮可听标准音</div>

  </div><!-- /pageTuner -->


  <!-- METRO-BLOCK:PAGES -->
  <!-- ══════════════════════════════════════════════════════
       节拍器页面（由 tools/add_metronome.py 插入）
       ══════════════════════════════════════════════════════ -->
  <div class="page" id="pageMetro">
    <div class="metro-wrap">

      <!-- 拍号选择（右上） -->
      <div class="metro-top">
        <button class="meter-btn" id="meterBtn" type="button">
          <span id="meterLabel">4/4</span>
          <svg class="chev" viewBox="0 0 10 10" aria-hidden="true">
            <path d="M2 4 L5 7 L8 4"/>
          </svg>
        </button>
      </div>

      <!-- 圆环：拖动调速 -->
      <div class="metro-ring-area">
        <div class="metro-ring" id="metroRing">
          <svg viewBox="0 0 200 200" aria-hidden="true">
            <!-- 底圈 -->
            <circle class="ring-track" cx="100" cy="100" r="90"/>
            <!-- 速度进度弧 -->
            <circle class="ring-progress" id="ringProgress"
                    cx="100" cy="100" r="90"
                    transform="rotate(135 100 100)"/>
            <!-- 每拍脉冲 -->
            <circle class="pulse-ring" id="pulseRing"
                    cx="100" cy="100" r="90"/>
          </svg>

          <div class="ring-center" id="ringCenter">
            <button class="ring-bpm" id="bpmValue" type="button"
                    aria-label="点一下可输入速度">120</button>
            <input class="ring-bpm-input" id="bpmInput"
                   type="text" inputmode="numeric"
                   maxlength="3" autocomplete="off"
                   aria-label="输入速度">
            <div class="ring-term" id="bpmTerm">Moderato</div>
          </div>
        </div>
      </div>

      <!-- 拍点 -->
      <div class="beat-dots" id="beatDots"></div>

    </div>
  </div>

  <!-- 拍号选择面板 -->
  <div class="meter-sheet" id="meterSheet">
    <div class="meter-sheet-body">
      <div class="meter-sheet-head">
        <span class="meter-sheet-title">拍号</span>
        <button class="meter-sheet-close" id="meterClose" type="button">完成</button>
      </div>
      <div class="meter-sheet-cols">
        <div class="meter-col">
          <div class="meter-col-title">分子</div>
          <div class="meter-grid" id="numGrid"></div>
        </div>
        <div class="meter-col">
          <div class="meter-col-title">分母</div>
          <div class="meter-grid" id="denGrid"></div>
        </div>
      </div>
    </div>
  </div>
  <!-- /METRO-BLOCK:PAGES -->

</div>

<script>

  /* ===== 读取主题色（由 tools/fix_theme.py 自动插入）=====
     画布（canvas）读不到 CSS 变量，只能在运行时取出来。
     只读一次就缓存 —— getComputedStyle 很慢，不能放在动画循环里。 */
  let __themeCache = null;
  function theme(){
    if (__themeCache) return __themeCache;
    let cs = null;
    try { cs = getComputedStyle(document.documentElement); } catch(e){}
    const get = (name, fallback) => {
      if (!cs) return fallback;
      const v = cs.getPropertyValue(name);
      return (v && v.trim()) || fallback;
    };
    __themeCache = {
      accent:     get('--accent', '#a0a0a0'),
      accentRgb:  get('--accent-rgb', '160,160,160'),
      successRgb: get('--success-rgb', '127,200,127'),
      surface2:   get('--surface-2', '#1f1f1f'),
      text:       get('--text', '#f0f0f0')
    };
    return __themeCache;
  }

(function(){
  'use strict';

  const NOTE_NAMES = ['C','C#','D','D#','E','F','F#','G','G#','A','A#','B'];

  const INSTRUMENTS = {
    guitar: {
      type: 'strings',
      strings: [
        { num: 6, name: 'E', oct: 2, midi: 40 },
        { num: 5, name: 'A', oct: 2, midi: 45 },
        { num: 4, name: 'D', oct: 3, midi: 50 },
        { num: 3, name: 'G', oct: 3, midi: 55 },
        { num: 2, name: 'B', oct: 3, midi: 59 },
        { num: 1, name: 'E', oct: 4, midi: 64 },
      ],
      detectRange: [70, 400],
      hint: '拨响琴弦即可 · 点琴弦按钮可听标准音',
    },
    ukulele: {
      type: 'strings',
      strings: [
        { num: 4, name: 'G', oct: 4, midi: 67 },
        { num: 3, name: 'C', oct: 4, midi: 60 },
        { num: 2, name: 'E', oct: 4, midi: 64 },
        { num: 1, name: 'A', oct: 4, midi: 69 },
      ],
      detectRange: [200, 500],
      hint: '4 弦标准调弦 G-C-E-A · 拨弦自动识别',
    },
    piano: {
      type: 'piano',
      detectRange: [65, 2100],
      hint: '按钢琴键可听标准音 · 弹奏自动识别',
    },
  };

  const IN_TUNE        = 3;
  const RMS_MIN        = 0.004;
  const WINDOW_SIZE    = 2048;
  const ANALYSIS_MS    = 65;
  const HISTORY_SIZE   = 3;
  const SWITCH_NEED    = 3;
  const EMA_SLOW       = 0.12;
  const EMA_FAST       = 0.32;
  const EMA_FAST_GAP   = 28;
  const NC_MIN         = 0.45;
  const NEEDLE_STIFF   = 0.10;
  const NEEDLE_DAMP    = 0.82;
  const NEEDLE_DEADZONE= 0.12;
  const STROBE_SPEED   = 1.0;
  const STROBE_PERIOD  = 28;
  const STROBE_STRIPE  = 12;

  /* 表盘几何 */
  const G_CX = 200, G_CY = 210, G_R = 140;

  const appEl       = document.getElementById('app');
  const needleDot   = document.getElementById('needleDot');
  const ticksEl     = document.getElementById('ticks');
  const noteEl      = document.getElementById('noteName');
  const centsEl     = document.getElementById('centsText');
  const freqEl      = document.getElementById('freqText');
  const stringsEl   = document.getElementById('stringsEl');
  const pianoArea   = document.getElementById('pianoArea');
  const pianoKeysEl = document.getElementById('pianoKeys');
  const octDownEl   = document.getElementById('octDown');
  const octUpEl     = document.getElementById('octUp');
  const octValueEl  = document.getElementById('octValue');
  const modeTabsEl  = document.querySelectorAll('.mode-tab');
  const startBtn    = document.getElementById('startBtn');
  const micStatus   = document.getElementById('micStatus');
  const micText     = document.getElementById('micText');
  const levelFill   = document.getElementById('levelFill');
  const hintText    = document.getElementById('hintText');
  const a4DownEl    = document.getElementById('a4Down');
  const a4UpEl      = document.getElementById('a4Up');
  const a4ValueEl   = document.getElementById('a4Value');
  const viewToggleEl= document.getElementById('viewToggle');
  const gaugeBlock  = document.getElementById('gaugeBlock');
  const strobeView  = document.getElementById('strobeView');
  const strobeCanvas= document.getElementById('strobeCanvas');
  const strobeCtx   = strobeCanvas.getContext('2d');
  const settingsBtn = document.getElementById('settingsBtn');
  const settingsPanel = document.getElementById('settingsPanel');

  let mode = 'guitar';
  let a4Cal = 440;
  let view = 'needle';
  let audioCtx = null;
  let analyser = null;
  let timeBuf  = null;
  let corrBuf  = null;
  let running  = false;
  let playingRef = false;

  let lockedKey = null;
  let activeKey = null;

  let freqHistory = [];
  let displayedId = null;
  let candidateId = null;
  let candidateN  = 0;
  let smoothCents = 0;
  let needleAngle = 0;
  let needleVel   = 0;
  let needleTarget= 0;
  let strobePhase = 0;
  let smoothLevel = 0;
  let lastGoodTs  = 0;
  let missFrames  = 0;

  let pianoOctave = 4;

  function getFreq(midi){ return a4Cal * Math.pow(2, (midi - 69) / 12); }
  function freqToMidi(f){ return 69 + 12 * Math.log2(f / a4Cal); }
  function midiToNote(midi){
    const r = Math.round(midi);
    return { midi: r, name: NOTE_NAMES[((r % 12) + 12) % 12], octave: Math.floor(r / 12) - 1 };
  }

  settingsBtn.addEventListener('click', () => {
    const open = settingsPanel.classList.toggle('open');
    settingsBtn.classList.toggle('active', open);
  });

  /* 画刻度 */
  (function buildTicks(){
    const NS = 'http://www.w3.org/2000/svg';
    [-50, -25, 0, 25, 50].forEach(c => {
      const deg = c * 0.9;
      const rad = deg * Math.PI / 180;
      const isMain = (c === 0);
      const rIn  = G_R - (isMain ? 16 : 8);
      const rOut = G_R;
      const x1 = G_CX + rIn * Math.sin(rad);
      const y1 = G_CY - rIn * Math.cos(rad);
      const x2 = G_CX + rOut * Math.sin(rad);
      const y2 = G_CY - rOut * Math.cos(rad);
      const line = document.createElementNS(NS, 'line');
      line.setAttribute('x1', x1.toFixed(2));
      line.setAttribute('y1', y1.toFixed(2));
      line.setAttribute('x2', x2.toFixed(2));
      line.setAttribute('y2', y2.toFixed(2));
      line.setAttribute('stroke', isMain ? 'rgba(var(--success-rgb),.7)' : 'rgba(240,235,227,.2)');
      line.setAttribute('stroke-width', isMain ? '2' : '1.5');
      line.setAttribute('stroke-linecap', 'round');
      ticksEl.appendChild(line);
    });
  })();

  let stringBtns = [];
  function buildStringButtons(){
    stringsEl.innerHTML = '';
    stringBtns = [];
    const inst = INSTRUMENTS[mode];
    if (inst.type !== 'strings') return;
    stringsEl.className = 'strings ' + mode;
    inst.strings.forEach((s, i) => {
      const b = document.createElement('button');
      b.className = 'sbtn';
      b.type = 'button';
      b.innerHTML = '<span class="num">' + s.num + '弦</span>' +
                    '<span class="nm">' + s.name + '</span>';
      b.addEventListener('click', () => onStringClick(i));
      stringsEl.appendChild(b);
      stringBtns.push(b);
    });
  }

  let pianoKeyBtns = [];
  function buildPianoKeys(){
    pianoKeysEl.innerHTML = '';
    pianoKeyBtns = [];
    NOTE_NAMES.forEach((name, pc) => {
      const isBlack = name.includes('#');
      const b = document.createElement('button');
      b.className = 'pkey' + (isBlack ? ' black' : '');
      b.type = 'button';
      b.textContent = name;
      b.addEventListener('click', () => onPianoKeyClick(pc));
      pianoKeysEl.appendChild(b);
      pianoKeyBtns.push(b);
    });
  }

  function updateButtons(){
    if (mode === 'piano'){
      pianoKeyBtns.forEach((b, pc) => {
        const midi = (pianoOctave + 1) * 12 + pc;
        const isActive = (activeKey === midi);
        const isLocked = (lockedKey === midi);
        b.classList.toggle('active', isActive || isLocked);
        b.classList.toggle('in-tune', isLocked && running && Math.abs(smoothCents) <= IN_TUNE);
      });
    } else {
      stringBtns.forEach((b, i) => {
        const isActive = (activeKey === i);
        const isLocked = (lockedKey === i);
        b.classList.toggle('active', isActive || isLocked);
        b.classList.toggle('in-tune', isLocked && running && Math.abs(smoothCents) <= IN_TUNE);
      });
    }
  }

  function switchMode(newMode){
    if (mode === newMode) return;
    mode = newMode;
    lockedKey = null; activeKey = null;
    resetSmoothing();
    modeTabsEl.forEach(t => {
      t.classList.toggle('active', t.dataset.mode === newMode);
    });
    const inst = INSTRUMENTS[mode];
    if (inst.type === 'strings'){
      stringsEl.style.display = '';
      pianoArea.classList.remove('show');
      buildStringButtons();
    } else {
      stringsEl.style.display = 'none';
      pianoArea.classList.add('show');
      buildPianoKeys();
      updateOctaveDisplay();
    }
    hintText.innerHTML = inst.hint;
    clearDisplay();
    centsEl.textContent = running ? '拨响或弹奏一个音…' : '点击开始';
    centsEl.className = 'cents';
    updateButtons();
  }

  modeTabsEl.forEach(t => {
    t.addEventListener('click', () => switchMode(t.dataset.mode));
  });

  function updateOctaveDisplay(){
    octValueEl.textContent = 'C' + pianoOctave;
    octDownEl.disabled = (pianoOctave <= 1);
    octUpEl.disabled   = (pianoOctave >= 7);
  }
  octDownEl.addEventListener('click', () => {
    if (pianoOctave > 1){
      pianoOctave--;
      lockedKey = null; activeKey = null;
      resetSmoothing(); updateOctaveDisplay(); updateButtons();
    }
  });
  octUpEl.addEventListener('click', () => {
    if (pianoOctave < 7){
      pianoOctave++;
      lockedKey = null; activeKey = null;
      resetSmoothing(); updateOctaveDisplay(); updateButtons();
    }
  });

  function updateA4Display(){
    a4ValueEl.innerHTML = a4Cal + '<span class="unit">Hz</span>';
  }
  function nudgeA4(delta){
    const next = Math.round((a4Cal + delta) * 10) / 10;
    if (next < 430 || next > 450) return;
    a4Cal = next;
    updateA4Display();
    resetSmoothing();
  }
  a4DownEl.addEventListener('click', () => nudgeA4(-0.5));
  a4UpEl.addEventListener('click', () => nudgeA4(0.5));

  viewToggleEl.addEventListener('click', (e) => {
    const t = e.target.closest('.view-btn');
    if (!t) return;
    view = t.dataset.view;
    viewToggleEl.querySelectorAll('.view-btn').forEach(b => {
      b.classList.toggle('active', b.dataset.view === view);
    });
    if (view === 'needle'){
      gaugeBlock.classList.remove('hide');
      strobeView.classList.remove('show');
    } else {
      gaugeBlock.classList.add('hide');
      strobeView.classList.add('show');
      resizeStrobe();
    }
  });

  function resizeStrobe(){
    const dpr = window.devicePixelRatio || 1;
    const rect = strobeCanvas.getBoundingClientRect();
    strobeCanvas.width  = Math.round(rect.width * dpr);
    strobeCanvas.height = Math.round(rect.height * dpr);
  }
  window.addEventListener('resize', resizeStrobe);

  async function onStringClick(i){
    if (lockedKey === i){
      lockedKey = null; activeKey = null;
      resetSmoothing(); updateButtons(); return;
    }
    lockedKey = i; activeKey = i;
    resetSmoothing(); updateButtons();
    await playReference(getFreq(INSTRUMENTS[mode].strings[i].midi));
  }

  async function onPianoKeyClick(pc){
    const midi = (pianoOctave + 1) * 12 + pc;
    if (lockedKey === midi){
      lockedKey = null; activeKey = null;
      resetSmoothing(); updateButtons(); return;
    }
    lockedKey = midi; activeKey = midi;
    resetSmoothing(); updateButtons();
    await playReference(getFreq(midi));
  }

  async function ensureAudio(){
    if (!audioCtx){
      const AC = window.AudioContext || window.webkitAudioContext;
      audioCtx = new AC();
    }
    if (audioCtx.state === 'suspended'){
      try { await audioCtx.resume(); } catch(e){}
    }
    return audioCtx;
  }

  async function playReference(freq, duration){
    duration = duration || 1.4;
    const ctx = await ensureAudio();
    const now = ctx.currentTime;
    const osc1 = ctx.createOscillator();
    osc1.type = 'triangle';
    osc1.frequency.value = freq;
    const osc2 = ctx.createOscillator();
    osc2.type = 'sine';
    osc2.frequency.value = freq * 2;
    const g2 = ctx.createGain(); g2.gain.value = 0.12;
    const master = ctx.createGain();
    master.gain.setValueAtTime(0, now);
    master.gain.linearRampToValueAtTime(0.22, now + 0.025);
    master.gain.setValueAtTime(0.22, now + duration - 0.15);
    master.gain.linearRampToValueAtTime(0.0001, now + duration);
    osc1.connect(master);
    osc2.connect(g2).connect(master);
    master.connect(ctx.destination);
    osc1.start(now); osc2.start(now);
    osc1.stop(now + duration + 0.03);
    osc2.stop(now + duration + 0.03);
    playingRef = true;
    setTimeout(() => { playingRef = false; }, (duration + 0.15) * 1000);
  }

  function detectPitch(buf, sampleRate, minFreq, maxFreq){
    const SIZE = WINDOW_SIZE;
    const offset = buf.length - SIZE;
    let mean = 0;
    for (let i = 0; i < SIZE; i++) mean += buf[offset + i];
    mean /= SIZE;
    const minLag = Math.max(2, Math.floor(sampleRate / maxFreq));
    const maxLag = Math.min(SIZE - 2, Math.floor(sampleRate / minFreq));
    const c = corrBuf;
    let maxVal = -1, maxPos = -1;
    for (let lag = minLag; lag <= maxLag; lag++){
      let num = 0, d1 = 0, d2 = 0;
      const limit = SIZE - lag;
      for (let i = 0; i < limit; i++){
        const a = buf[offset + i] - mean;
        const b = buf[offset + i + lag] - mean;
        num += a * b; d1 += a * a; d2 += b * b;
      }
      const den = Math.sqrt(d1 * d2);
      const nc = den > 1e-9 ? num / den : 0;
      c[lag] = nc;
      if (nc > maxVal){ maxVal = nc; maxPos = lag; }
    }
    if (maxPos < 0 || maxVal < NC_MIN) return null;
    const thr = maxVal * 0.93;
    for (let lag = minLag + 1; lag < maxPos; lag++){
      if (c[lag] > thr && c[lag] >= c[lag-1] && c[lag] >= c[lag+1]){ maxPos = lag; break; }
    }
    let delta = 0;
    if (maxPos > minLag && maxPos < maxLag){
      const y1 = c[maxPos-1], y2 = c[maxPos], y3 = c[maxPos+1];
      const den = 2 * (y1 + y3 - 2 * y2);
      if (den !== 0) delta = -(y3 - y1) / den;
      if (delta > 1) delta = 1;
      if (delta < -1) delta = -1;
    }
    const period = maxPos + delta;
    if (period <= 0) return null;
    const freq = sampleRate / period;
    if (freq < minFreq || freq > maxFreq) return null;
    return freq;
  }

  function processPitch(freqRaw){
    freqHistory.push(freqRaw);
    if (freqHistory.length > HISTORY_SIZE) freqHistory.shift();
    const sorted = freqHistory.slice().sort((a, b) => a - b);
    const median = sorted[Math.floor(sorted.length / 2)];
    let candId;
    if (mode === 'piano'){
      candId = Math.round(freqToMidi(median));
    } else {
      const strings = INSTRUMENTS[mode].strings;
      let best = 0, bestC = Infinity;
      for (let i = 0; i < strings.length; i++){
        const c = Math.abs(1200 * Math.log2(median / getFreq(strings[i].midi)));
        if (c < bestC){ bestC = c; best = i; }
      }
      candId = best;
    }
    let displayId;
    if (lockedKey !== null){
      displayId = lockedKey;
      candidateId = null; candidateN = 0;
    } else if (displayedId === null){
      displayedId = candId; displayId = candId;
      smoothCents = 0; candidateId = null; candidateN = 0;
    } else if (candId === displayedId){
      candidateId = null; candidateN = 0; displayId = displayedId;
    } else {
      if (candidateId === candId) candidateN++;
      else { candidateId = candId; candidateN = 1; }
      if (candidateN >= SWITCH_NEED){
        displayedId = candId; displayId = candId;
        smoothCents = 0; candidateId = null; candidateN = 0;
      } else displayId = displayedId;
    }
    let targetFreq;
    if (mode === 'piano') targetFreq = getFreq(displayId);
    else targetFreq = getFreq(INSTRUMENTS[mode].strings[displayId].midi);
    const centsRaw = 1200 * Math.log2(median / targetFreq);
    const gap = Math.abs(centsRaw - smoothCents);
    const alpha = gap > EMA_FAST_GAP ? EMA_FAST : EMA_SLOW;
    smoothCents += (centsRaw - smoothCents) * alpha;
    updateDisplay(displayId, median, smoothCents);
  }

  function updateDisplay(displayId, freq, cents){
    const clamped = Math.max(-50, Math.min(50, cents));
    needleTarget = clamped * 0.9;
    const absC = Math.abs(cents);
    const ok = absC <= IN_TUNE;
    appEl.classList.toggle('tuning-ok', ok);

    let displayName, displayOct;
    if (mode === 'piano'){
      const n = midiToNote(displayId);
      displayName = n.name; displayOct = n.octave;
    } else {
      const s = INSTRUMENTS[mode].strings[displayId];
      displayName = s.name; displayOct = s.oct;
    }
    noteEl.innerHTML = '<span class="letter">' + displayName + '</span>' +
                       '<span class="oct">' + displayOct + '</span>';
    freqEl.textContent = freq.toFixed(2) + ' Hz';
    if (ok){ centsEl.textContent = '准音'; centsEl.className = 'cents ok'; }
    else if (cents > 0){ centsEl.textContent = '+' + cents.toFixed(0) + '¢  偏高'; centsEl.className = 'cents high'; }
    else { centsEl.textContent = Math.abs(cents).toFixed(0) + '¢  偏低'; centsEl.className = 'cents low'; }
    activeKey = displayId;
    updateButtons();
  }

  function clearDisplay(){
    noteEl.innerHTML = '<span class="letter">–</span>';
    centsEl.textContent = running ? '拨响一个音…' : '点击开始';
    centsEl.className = 'cents';
    freqEl.textContent = '';
    needleTarget = 0; smoothCents = 0;
    displayedId = null; candidateId = null; candidateN = 0;
    activeKey = lockedKey;
    appEl.classList.remove('tuning-ok');
    updateButtons();
  }

  function resetSmoothing(){
    freqHistory = [];
    displayedId = null; candidateId = null; candidateN = 0;
    smoothCents = 0; needleVel = 0; needleTarget = 0;
  }

  function updateNeedle(){
    const diff = needleTarget - needleAngle;
    needleVel += diff * NEEDLE_STIFF;
    needleVel *= NEEDLE_DAMP;
    needleAngle += needleVel;
    if (Math.abs(diff) < NEEDLE_DEADZONE && Math.abs(needleVel) < 0.05){
      needleAngle = needleTarget; needleVel = 0;
    }
    const rad = needleAngle * Math.PI / 180;
    const x = G_CX + G_R * Math.sin(rad);
    const y = G_CY - G_R * Math.cos(rad);
    needleDot.setAttribute('cx', x.toFixed(2));
    needleDot.setAttribute('cy', y.toFixed(2));
  }

  function drawStrobe(){
    const W = strobeCanvas.width;
    const H = strobeCanvas.height;
    if (W === 0 || H === 0) return;
    strobeCtx.setTransform(1, 0, 0, 1, 0, 0);
    strobeCtx.clearRect(0, 0, W, H);
    strobeCtx.fillStyle = theme().surface2;
    strobeCtx.fillRect(0, 0, W, H);
    const dpr = window.devicePixelRatio || 1;
    const inTune = Math.abs(smoothCents) < 1.2;
    const period = STROBE_PERIOD * dpr;
    const stripe = STROBE_STRIPE * dpr;
    const offset = ((strobePhase * dpr) % period + period) % period;
    strobeCtx.fillStyle = inTune
        ? `rgba(${theme().successRgb},.55)`
        : `rgba(${theme().accentRgb},.42)`;
    for (let x = -period - offset; x < W + period; x += period){
      strobeCtx.fillRect(x, 0, stripe, H);
    }
  }

  let lastAnalysis = 0;
  function loop(ts){
    if (!running) return;
    if (!playingRef && ts - lastAnalysis > ANALYSIS_MS){
      lastAnalysis = ts;
      analyser.getFloatTimeDomainData(timeBuf);
      let sum = 0;
      for (let i = 0; i < timeBuf.length; i++) sum += timeBuf[i] * timeBuf[i];
      const rms = Math.sqrt(sum / timeBuf.length);
      const targetLv = Math.min(100, Math.sqrt(rms) * 380);
      smoothLevel += (targetLv - smoothLevel) * 0.35;
      levelFill.style.width = smoothLevel.toFixed(0) + '%';
      if (rms < RMS_MIN){
        missFrames++;
        freqHistory = [];
        candidateId = null; candidateN = 0;
        if (missFrames > 12 && lastGoodTs && ts - lastGoodTs > 800) clearDisplay();
      } else {
        const [minF, maxF] = INSTRUMENTS[mode].detectRange;
        const f = detectPitch(timeBuf, audioCtx.sampleRate, minF, maxF);
        if (f){ missFrames = 0; lastGoodTs = ts; processPitch(f); }
        else {
          missFrames++;
          if (missFrames > 15 && lastGoodTs && ts - lastGoodTs > 900) clearDisplay();
        }
      }
    }
    updateNeedle();
    if (Math.abs(smoothCents) >= 0.4){
      strobePhase += smoothCents * STROBE_SPEED;
      if (strobePhase > 1e6)  strobePhase -= 1e6;
      if (strobePhase < -1e6) strobePhase += 1e6;
    }
    if (view === 'strobe') drawStrobe();
    requestAnimationFrame(loop);
  }

  async function start(){
    startBtn.disabled = true;
    startBtn.textContent = '启动中';
    try {
      if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia){
        throw new Error('浏览器不支持麦克风');
      }
      const ctx = await ensureAudio();
      const stream = await navigator.mediaDevices.getUserMedia({
        audio: { echoCancellation: false, noiseSuppression: false, autoGainControl: true, channelCount: 1 }
      });
      const src = ctx.createMediaStreamSource(stream);
      const hp = ctx.createBiquadFilter();
      hp.type = 'highpass'; hp.frequency.value = 55; hp.Q.value = 0.6;
      const lp = ctx.createBiquadFilter();
      lp.type = 'lowpass'; lp.frequency.value = 3500; lp.Q.value = 0.6;
      analyser = ctx.createAnalyser();
      analyser.fftSize = 8192;
      analyser.smoothingTimeConstant = 0;
      src.connect(hp); hp.connect(lp); lp.connect(analyser);
      timeBuf = new Float32Array(analyser.fftSize);
      corrBuf = new Float32Array(analyser.fftSize);
      running = true;
      lastGoodTs = performance.now();
      lastAnalysis = 0; missFrames = 0; smoothLevel = 0;
      resetSmoothing();
      micStatus.classList.add('on');
      micText.textContent = '监听中';
      startBtn.disabled = false;
      startBtn.textContent = '停止';
      startBtn.classList.add('stop');
      clearDisplay();
      centsEl.textContent = '拨响一个音…';
      requestAnimationFrame(() => {
        resizeStrobe();
        requestAnimationFrame(loop);
      });
    } catch (err){
      console.error(err);
      let msg = '无法访问麦克风';
      if (err && err.name === 'NotAllowedError') msg = '麦克风权限被拒绝';
      else if (err && err.name === 'NotFoundError') msg = '未找到麦克风设备';
      else if (err && err.name === 'NotReadableError') msg = '麦克风被其他程序占用';
      else if (err && err.message) msg = err.message;
      startBtn.disabled = false;
      startBtn.textContent = '开始调音';
      micStatus.classList.remove('on');
      micText.textContent = '未启动';
      alert(msg);
    }
  }

  function stop(){
    running = false;
    if (audioCtx){ try { audioCtx.close(); } catch(e){} audioCtx = null; }
    analyser = null;
    smoothLevel = 0;
    levelFill.style.width = '0%';
    micStatus.classList.remove('on');
    micText.textContent = '已停止';
    startBtn.textContent = '开始调音';
    startBtn.classList.remove('stop');
    clearDisplay();
    centsEl.textContent = '点击开始';
  }

  startBtn.addEventListener('click', () => {
    if (running) stop(); else start();
  });

  document.addEventListener('visibilitychange', () => {
    if (document.hidden){
      if (audioCtx && audioCtx.state === 'running') audioCtx.suspend();
    } else {
      if (audioCtx && audioCtx.state === 'suspended') audioCtx.resume();
    }
  });

  buildStringButtons();
  buildPianoKeys();
  updateOctaveDisplay();
  updateA4Display();
  updateButtons();
  clearDisplay();
  resizeStrobe();
})();
</script>
<script>
/* ===== 手机 App / PWA 适配（由 tools/build_web.py 自动插入） ===== */
(function () {
  var bridge  = window.ShixinApp;
  var inApp   = !!(bridge && bridge.isNativeApp && bridge.isNativeApp());
  var isAsset = location.hostname === 'appassets.androidplatform.net';

  /* 已在 App 内运行 → 隐藏“下载安装”入口 */
  if (inApp) {
    var row = document.getElementById('appRow');
    if (row) row.style.display = 'none';
  }

  /* 仅浏览器环境注册 Service Worker，提供离线缓存 */
  if (!inApp && !isAsset && 'serviceWorker' in navigator && location.protocol === 'https:') {
    window.addEventListener('load', function () {
      navigator.serviceWorker.register('/sw.js').catch(function () { /* 静默失败 */ });
    });
  }
})();
</script>

<!-- METRONOME-JS-INSERTED -->
<script>
/* ════════════════════════════════════════════════════════════
   节拍器（由 tools/add_metronome_js.py 插入）

     1. 核心逻辑 —— 重拍计算、速度术语、范围常量
     2. 音频引擎 —— Web Audio 预调度，保证节拍稳定
     3. 界面控制 —— 胶囊切换、拍号面板、圆环拖动、播放按钮
   ════════════════════════════════════════════════════════════ */

/* ─────────── 1. 核心逻辑 ─────────── */
/* ══════════════════════════════════════════════════════════════
   节拍器核心逻辑（纯计算，不碰 DOM / 音频）

   单独放在这里是为了能脱离浏览器测试 ——
   节拍器的重拍安排和速度术语都容易写错，需要能验证。
   ══════════════════════════════════════════════════════════════ */

/* ── 速度术语 ──
   按意大利传统区间划分，upTo 是上界（含）。
   中英对照方便教学时对应。 */
const TEMPO_TERMS = [
  { upTo: 40,       it: 'Grave',       cn: '庄板'   },
  { upTo: 60,       it: 'Largo',       cn: '广板'   },
  { upTo: 66,       it: 'Larghetto',   cn: '小广板' },
  { upTo: 76,       it: 'Adagio',      cn: '柔板'   },
  { upTo: 108,      it: 'Andante',     cn: '行板'   },
  { upTo: 120,      it: 'Moderato',    cn: '中板'   },
  { upTo: 168,      it: 'Allegro',     cn: '快板'   },
  { upTo: 200,      it: 'Presto',      cn: '急板'   },
  { upTo: Infinity, it: 'Prestissimo', cn: '最急板' },
];

function tempoTerm(bpm) {
  for (const t of TEMPO_TERMS) {
    if (bpm <= t.upTo) return t;
  }
  return TEMPO_TERMS[TEMPO_TERMS.length - 1];
}

/* ── 重拍安排 ──
   返回数组，每项取值：
     2 = 重拍（每小节第一拍）
     1 = 次重拍（分组头）
     0 = 弱拍

   规则（按先后顺序判断）：
     1. 分子 ≤ 4          → 只有第一拍重
     2. 分子是 3 的倍数     → 每三拍一组
        （6/8、9/8、12/8、6/4、9/4 ……）
     3. 3/8 特殊处理       → 当作单拍子，不分三组
     4. 分子是 4 的倍数     → 每四拍一组（12/16、16/16 这类）
     5. 其它（5、7 等）     → 第一拍重，其余弱
*/
function accentPattern(num, den) {
  const pattern = new Array(num).fill(0);
  if (num <= 0) return pattern;

  pattern[0] = 2;                       // 第一拍总是重拍

  if (num <= 4) return pattern;         // 单拍子，够简单

  // 复拍子：分子是 3 的倍数（且大于 3）
  const isCompound = (num % 3 === 0);
  // 3/8 视为单拍子（三拍等分，不按 3 分组）
  const shouldGroup = isCompound && !(den === 8 && num === 3);

  if (shouldGroup) {
    for (let i = 3; i < num; i += 3) {
      pattern[i] = 1;
    }
    return pattern;
  }

  // 四拍分组：12/16、16/16 这类复拍子
  if (num % 4 === 0) {
    for (let i = 4; i < num; i += 4) {
      pattern[i] = 1;
    }
    return pattern;
  }

  // 其它（5、7、11 ……）：第一拍重，其余弱
  return pattern;
}

/* ── 拍号范围 ──
   分子 2-12，分母 2/4/6/8/12 */
const NUM_MIN = 2;
const NUM_MAX = 12;
const DEN_VALUES = [2, 4, 6, 8, 12];

function clampNum(n) {
  return Math.max(NUM_MIN, Math.min(NUM_MAX, Math.round(n)));
}

function stepDen(den, dir) {
  let i = DEN_VALUES.indexOf(den);
  if (i < 0) i = 1;                     // 认不出来就当 4/4
  i = (i + dir + DEN_VALUES.length) % DEN_VALUES.length;
  return DEN_VALUES[i];
}

/* ── 常用拍号（下拉里的快捷项）── */
const METER_PRESETS = [
  { num: 2, den: 4 },
  { num: 3, den: 4 },
  { num: 4, den: 4 },
  { num: 6, den: 8 },
  { num: 2, den: 2 },
];

/* ── BPM 范围 ── */
const BPM_MIN = 30;
const BPM_MAX = 250;

function clampBpm(b) {
  return Math.max(BPM_MIN, Math.min(BPM_MAX, Math.round(b)));
}

/* ── 拖动灵敏度 ──
   转一圈（360°）大约变化多少 BPM。
   90 的手感：转 60° 变 15 BPM，转一圈变 90。
   太小调不动，太大调不准。 */
const DRAG_BPM_PER_TURN = 90;

/* ─────────── 2. 音频引擎 ─────────── */
/* ══════════════════════════════════════════════════════════════
   节拍器音频引擎

   为什么不用 setTimeout 直接发声：
     setTimeout 的误差会累积（每拍偏几毫秒，一分钟后能差出半拍），
     而且页面切到后台会被浏览器降频到 1 次/秒，节拍直接乱掉。

   做法：Web Audio 的预调度（look-ahead scheduler）
     · 每 25ms 醒一次（这个频率够低，不影响性能）
     · 每次把未来 100ms 内该响的拍子，提前"预约"给音频时钟
     · 到点由音频硬件精确触发，不依赖 JS 定时精度
     结果：切后台、页面卡顿，节拍都不会漂。
   ══════════════════════════════════════════════════════════════ */

const LOOKAHEAD_MS = 25;      // 多久检查一次
const SCHEDULE_AHEAD = 0.1;   // 提前多少秒预排（秒）

function Metronome() {
  this.ctx = null;

  this.bpm = 120;
  this.num = 4;               // 分子
  this.den = 4;               // 分母
  this.pattern = [2, 0, 0, 0];  // 重拍安排

  this.playing = false;
  this.currentBeat = -1;      // 当前拍（用于界面高亮）
  this.nextNoteTime = 0;      // 下一拍的音频时间
  this.beatIndex = 0;         // 排到第几拍了
  this.timerId = null;

  this.onBeat = null;         // 每拍的回调（用于界面闪动）

  // 音量（0-1）
  this.volume = 0.7;
}

/* ── 拍间隔（秒）──
   一拍的长度 = 全音符 ÷ 分母。
   而全音符 = 4 个四分音符，所以：

     拍长 = (60 / BPM) × (4 / 分母)

   验证：
     分母 4  → 60/BPM × 1    = 四分音符
     分母 8  → 60/BPM × 0.5  = 八分音符
     分母 2  → 60/BPM × 2    = 二分音符
     分母 6  → 60/BPM × 2/3  = 六分音符
     分母 12 → 60/BPM × 1/3  = 十二分音符
*/
Metronome.prototype.beatDuration = function () {
  const quarter = 60 / this.bpm;
  return quarter * (4 / this.den);
};

/* ── 确保音频上下文 ── */
Metronome.prototype.ensureCtx = function () {
  if (!this.ctx) {
    const AC = window.AudioContext || window.webkitAudioContext;
    this.ctx = new AC();
  }
  if (this.ctx.state === 'suspended') {
    this.ctx.resume();
  }
  return this.ctx;
};

/* ── 合成一声"嗒" ──
   用正弦波 + 极快衰减，接近木鱼/电子节拍器的听感。
   重拍：音高更高、更长、更响。
   次重拍：中间水平。
   弱拍：最低最轻。

   at  —— 何时发声（音频时间轴）
   kind —— 2 重拍 / 1 次重拍 / 0 弱拍
*/
Metronome.prototype.click = function (at, kind) {
  const ctx = this.ctx;

  // 音高：重拍高，弱拍低
  const freq = kind === 2 ? 1760 : (kind === 1 ? 1320 : 1050);
  // 音量：重拍响
  const gain = kind === 2 ? 1.0 : (kind === 1 ? 0.72 : 0.52);
  // 衰减：重拍稍长，让重音更"实"
  const decay = kind === 2 ? 0.055 : 0.038;

  const osc = ctx.createOscillator();
  const env = ctx.createGain();

  osc.type = 'sine';
  osc.frequency.setValueAtTime(freq, at);
  // 轻微下滑，声音更自然（不滑会像纯电子音，偏"硬"）
  osc.frequency.exponentialRampToValueAtTime(freq * 0.86, at + decay);

  // 音量包络：瞬间起、快速落
  const peak = gain * this.volume * 0.42;
  env.gain.setValueAtTime(0, at);
  env.gain.linearRampToValueAtTime(peak, at + 0.0012);
  env.gain.exponentialRampToValueAtTime(0.0001, at + decay);

  osc.connect(env);
  env.connect(ctx.destination);

  osc.start(at);
  osc.stop(at + decay + 0.01);

  // 起音那一瞬加一点噪声，模拟"敲击"的质感。
  // 纯正弦听起来太"电子"，加噪声后更像木头/鼓。
  const nLen = Math.floor(ctx.sampleRate * 0.006);
  if (nLen > 0) {
    const buf = ctx.createBuffer(1, nLen, ctx.sampleRate);
    const data = buf.getChannelData(0);
    for (let i = 0; i < nLen; i++) {
      // 越往后越弱
      data[i] = (Math.random() * 2 - 1) * (1 - i / nLen) * 0.5;
    }
    const noise = ctx.createBufferSource();
    const nEnv = ctx.createGain();
    const nFilter = ctx.createBiquadFilter();

    noise.buffer = buf;
    // 带通滤波，让噪声集中在敲击频段，不刺耳
    nFilter.type = 'bandpass';
    nFilter.frequency.value = freq * 0.55;
    nFilter.Q.value = 1.2;

    nEnv.gain.setValueAtTime(peak * 0.5, at);
    nEnv.gain.exponentialRampToValueAtTime(0.0001, at + 0.012);

    noise.connect(nFilter);
    nFilter.connect(nEnv);
    nEnv.connect(ctx.destination);

    noise.start(at);
    noise.stop(at + 0.02);
  }
};

/* ── 调度循环 ──
   把 SCHEDULE_AHEAD 秒内该响的拍子全部预约出去。 */
Metronome.prototype.scheduler = function () {
  const ctx = this.ctx;
  if (!ctx || !this.playing) return;

  while (this.nextNoteTime < ctx.currentTime + SCHEDULE_AHEAD) {
    const kind = this.pattern[this.beatIndex] !== undefined
      ? this.pattern[this.beatIndex]
      : 0;

    this.click(this.nextNoteTime, kind);

    // 通知界面（延后到真正发声的时刻再闪，避免提前闪）
    if (this.onBeat) {
      const delay = (this.nextNoteTime - ctx.currentTime) * 1000;
      const idx = this.beatIndex;
      setTimeout(() => {
        if (this.playing) this.onBeat(idx, kind);
      }, Math.max(0, delay));
    }

    // 推进到下一拍
    this.nextNoteTime += this.beatDuration();
    this.beatIndex = (this.beatIndex + 1) % this.num;
  }
};

/* ── 开始 ── */
Metronome.prototype.start = function () {
  if (this.playing) return;
  this.ensureCtx();

  this.playing = true;
  this.beatIndex = 0;
  // 稍微延后一点起拍，避免第一声被切掉
  this.nextNoteTime = this.ctx.currentTime + 0.06;

  this.scheduler();
  this.timerId = setInterval(() => this.scheduler(), LOOKAHEAD_MS);
};

/* ── 停止 ── */
Metronome.prototype.stop = function () {
  this.playing = false;
  if (this.timerId) {
    clearInterval(this.timerId);
    this.timerId = null;
  }
  this.beatIndex = 0;
  this.currentBeat = -1;
};

/* ── 改速度（运行中也能立即生效）── */
Metronome.prototype.setBpm = function (bpm) {
  this.bpm = clampBpm(bpm);
};

/* ── 改拍号 ──
   同时重算重拍安排。如果正在响，下一小节生效（不打断当前小节）。 */
Metronome.prototype.setMeter = function (num, den) {
  this.num = clampNum(num);
  this.den = den;
  this.pattern = accentPattern(this.num, this.den);

  if (this.beatIndex >= this.num) {
    this.beatIndex = 0;
  }
};

/* ── 拍号文字 ── */
Metronome.prototype.meterLabel = function () {
  return this.num + '/' + this.den;
};


/* ─────────── 3. 界面控制 ─────────── */

/* ══════════════════════════════════════════════════════════════
   节拍器界面（由 tools/add_metronome_js.py 插入）
   ══════════════════════════════════════════════════════════════ */

(function initMetronome(){

  /* ══════════════════════════════════════════════════════
     元素
     ══════════════════════════════════════════════════════ */

  const el = {
    tabs:       document.getElementById('appTabs'),
    tabTuner:   document.getElementById('tabTuner'),
    tabMetro:   document.getElementById('tabMetro'),
    pageTuner:  document.getElementById('pageTuner'),
    pageMetro:  document.getElementById('pageMetro'),

    meterBtn:   document.getElementById('meterBtn'),
    meterLabel: document.getElementById('meterLabel'),
    meterSheet: document.getElementById('meterSheet'),
    meterClose: document.getElementById('meterClose'),
    numGrid:    document.getElementById('numGrid'),
    denGrid:    document.getElementById('denGrid'),

    ring:       document.getElementById('metroRing'),
    center:     document.getElementById('ringCenter'),
    progress:   document.getElementById('ringProgress'),
    pulseRing:  document.getElementById('pulseRing'),
    bpmValue:   document.getElementById('bpmValue'),
    bpmInput:   document.getElementById('bpmInput'),
    bpmTerm:    document.getElementById('bpmTerm'),
    beatDots:   document.getElementById('beatDots'),
  };

  // 缺任何一个都不往下走 —— 后面到处在用，
  // 中途爆 null 更难查。
  const missing = Object.keys(el).filter(k => !el[k]);
  if (missing.length) {
    console.warn('[节拍器] 缺少元素，已跳过初始化：', missing.join(', '));
    return;
  }

  const metro = new Metronome();

  // 是否正在输入速度（切页、空格键都要看这个）
  let editing = false;
  let currentPage = 'tuner';

  /* ══════════════════════════════════════════════════════
     页面切换（胶囊滑块）
     ══════════════════════════════════════════════════════ */

  function switchPage(page) {
    if (page === currentPage) return;
    currentPage = page;

    const isMetro = (page === 'metro');

    el.tabTuner.classList.toggle('active', !isMetro);
    el.tabMetro.classList.toggle('active',  isMetro);
    el.tabs.dataset.index = isMetro ? '1' : '0';

    el.pageTuner.classList.toggle('active', !isMetro);
    el.pageMetro.classList.toggle('active',  isMetro);

    document.body.dataset.page = page;

    if (isMetro) {
      // 切到节拍页：停掉调音器，释放麦克风。
      // running/stop 在调音器自己的闭包里，这里拿不到，
      // 所以看麦克风状态灯（由调音器维护），再点它的按钮触发停止。
      try {
        const mic = document.getElementById('micStatus');
        const tunerBtn = document.getElementById('startBtn');
        if (mic && mic.classList.contains('on') && tunerBtn) {
          tunerBtn.click();
        }
      } catch (e) {}
    } else {
      // 切回调音页：节拍器停掉。
      // 它的声音会被麦克风收进去，导致音高检测乱跳。
      if (metro.playing) stopMetro();
    }

    // 正在输入速度的话，先结束输入（避免输入框一直张着）
    if (editing) endEdit(true);

    // 顺手收起设置面板 —— 切页后还张着会显得乱
    try {
      const panel = document.getElementById('settingsPanel');
      const gear  = document.getElementById('settingsBtn');
      if (panel && panel.classList.contains('open')) {
        panel.classList.remove('open');
        if (gear) gear.classList.remove('active');
      }
    } catch (e) {}
  }

  el.tabTuner.addEventListener('click', () => switchPage('tuner'));
  el.tabMetro.addEventListener('click', () => switchPage('metro'));

  /* ══════════════════════════════════════════════════════
     拍号选择面板
     ══════════════════════════════════════════════════════ */

  // 生成数字网格
  function buildGrids() {
    // 分子：NUM_MIN 到 NUM_MAX
    let html = '';
    for (let n = NUM_MIN; n <= NUM_MAX; n++) {
      html += `<button class="meter-item" type="button" data-num="${n}">${n}</button>`;
    }
    el.numGrid.innerHTML = html;

    // 分母：只有几个固定值
    html = '';
    DEN_VALUES.forEach(d => {
      html += `<button class="meter-item" type="button" data-den="${d}">${d}</button>`;
    });
    el.denGrid.innerHTML = html;

    // 绑定
    el.numGrid.querySelectorAll('.meter-item').forEach(b => {
      b.addEventListener('click', () => setMeter(+b.dataset.num, metro.den));
    });
    el.denGrid.querySelectorAll('.meter-item').forEach(b => {
      b.addEventListener('click', () => setMeter(metro.num, +b.dataset.den));
    });
  }

  function syncGridHighlight() {
    el.numGrid.querySelectorAll('.meter-item').forEach(b => {
      b.classList.toggle('active', +b.dataset.num === metro.num);
    });
    el.denGrid.querySelectorAll('.meter-item').forEach(b => {
      b.classList.toggle('active', +b.dataset.den === metro.den);
    });
  }

  function openSheet() {
    el.meterSheet.classList.add('open');
  }
  function closeSheet() {
    el.meterSheet.classList.remove('open');
  }

  el.meterBtn.addEventListener('click', openSheet);
  el.meterClose.addEventListener('click', closeSheet);
  // 点遮罩也能关
  el.meterSheet.addEventListener('click', (e) => {
    if (e.target === el.meterSheet) closeSheet();
  });

  /* ══════════════════════════════════════════════════════
     拍号设置
     ══════════════════════════════════════════════════════ */

  function setMeter(num, den) {
    metro.setMeter(num, den);

    el.meterLabel.textContent = metro.num + '/' + metro.den;
    syncGridHighlight();
    buildBeatDots();
    clearBeatHighlight();
  }

  /* ══════════════════════════════════════════════════════
     拍点指示
     ══════════════════════════════════════════════════════ */

  function buildBeatDots() {
    el.beatDots.innerHTML = '';
    // 拍子多的话缩小间距，避免挤成一片
    el.beatDots.classList.toggle('dense', metro.num > 8);

    for (let i = 0; i < metro.num; i++) {
      const d = document.createElement('div');
      d.className = 'beat-dot' + (metro.pattern[i] === 2 ? ' accent' : '');
      el.beatDots.appendChild(d);
    }
  }

  function clearBeatHighlight() {
    el.beatDots.querySelectorAll('.beat-dot').forEach(d => d.classList.remove('on'));
    el.pulseRing.classList.remove('beat');
  }

  function highlightBeat(index, kind) {
    const dots = el.beatDots.querySelectorAll('.beat-dot');
    dots.forEach((d, i) => d.classList.toggle('on', i === index));

    // 脉冲：先移除再加，让动画能重播
    el.pulseRing.classList.remove('beat');
    void el.pulseRing.offsetWidth;
    el.pulseRing.classList.add('beat');
  }

  /* ══════════════════════════════════════════════════════
     BPM 显示
     ══════════════════════════════════════════════════════ */

  // 进度弧：270° 的弧，按 BPM 在范围内的比例显示
  const RING_R = 90;
  const RING_C = 2 * Math.PI * RING_R;      // 周长
  const ARC_LEN = RING_C * 0.75;            // 270° 的弧长

  function updateProgress() {
    const ratio = (metro.bpm - BPM_MIN) / (BPM_MAX - BPM_MIN);
    const len = ARC_LEN * Math.max(0, Math.min(1, ratio));
    el.progress.style.strokeDasharray = len + ' ' + RING_C;
  }

  function paintBpm() {
    el.bpmValue.textContent = metro.bpm;
    const t = tempoTerm(metro.bpm);
    el.bpmTerm.textContent = t.it;
    updateProgress();
  }

  function setBpm(bpm) {
    const old = metro.bpm;
    metro.setBpm(bpm);
    if (metro.bpm === old) return;
    paintBpm();
  }

  /* ══════════════════════════════════════════════════════
     键盘输入 BPM（点数字进入）
     ══════════════════════════════════════════════════════ */

  function beginEdit() {
    if (editing) return;
    editing = true;

    el.bpmInput.value = metro.bpm;
    el.bpmValue.classList.add('hidden');
    el.bpmInput.classList.add('show');

    // 聚焦并全选，方便直接覆盖输入
    setTimeout(() => {
      el.bpmInput.focus();
      try { el.bpmInput.setSelectionRange(0, 9); } catch (e) {}
    }, 30);
  }

  function endEdit(commit) {
    if (!editing) return;
    editing = false;

    if (commit) {
      const raw = (el.bpmInput.value || '').replace(/[^0-9]/g, '');
      if (raw) {
        setBpm(clampBpm(parseInt(raw, 10)));
      }
    }

    el.bpmInput.classList.remove('show');
    el.bpmValue.classList.remove('hidden');
    paintBpm();
  }

  el.bpmValue.addEventListener('click', (e) => {
    e.stopPropagation();
    beginEdit();
  });

  el.bpmInput.addEventListener('input', () => {
    // 只留数字，最多 3 位
    const clean = el.bpmInput.value.replace(/[^0-9]/g, '').slice(0, 3);
    if (clean !== el.bpmInput.value) el.bpmInput.value = clean;
  });

  el.bpmInput.addEventListener('keydown', (e) => {
    e.stopPropagation();          // 不要触发空格键的播放/停止
    if (e.key === 'Enter') {
      e.preventDefault();
      endEdit(true);
      el.bpmInput.blur();
    } else if (e.key === 'Escape') {
      e.preventDefault();
      endEdit(false);
      el.bpmInput.blur();
    }
  });

  // 失焦就确认（手机上点空白处也会走这里）
  el.bpmInput.addEventListener('blur', () => endEdit(true));

  // 在输入框上的触摸/鼠标操作不要传给圆环
  ['pointerdown', 'pointermove', 'pointerup', 'click'].forEach(ev => {
    el.bpmInput.addEventListener(ev, (e) => e.stopPropagation());
  });

  /* ══════════════════════════════════════════════════════
     圆环拖动调速
     ══════════════════════════════════════════════════════ */

  let drag = null;

  // 触点相对圆心的角度（度，顺时针，0 = 正右）
  function angleAt(clientX, clientY) {
    const rect = el.ring.getBoundingClientRect();
    const cx = rect.left + rect.width / 2;
    const cy = rect.top + rect.height / 2;
    return Math.atan2(clientY - cy, clientX - cx) * 180 / Math.PI;
  }

  function onDown(e) {
    // 圆形内的输入要素不算拖动：数字、输入框
    if (e.target.closest) {
      if (e.target.closest('.ring-bpm')) return;
      if (e.target.closest('.ring-bpm-input')) return;
    }

    // 正在输入速度时，先结束输入，不要误触拖动
    if (editing) return;

    const x = e.clientX, y = e.clientY;
    drag = {
      last:   angleAt(x, y),
      start:  metro.bpm,
      accum:  0,
      moved:  false,
    };

    try { el.ring.setPointerCapture(e.pointerId); } catch (err) {}
  }

  function onMove(e) {
    if (!drag) return;

    const a = angleAt(e.clientX, e.clientY);

    // 角度增量，处理跨越 ±180° 的回绕
    let d = a - drag.last;
    if (d > 180) d -= 360;
    if (d < -180) d += 360;

    drag.accum += d;
    drag.last = a;

    // 位移太小就当没动 —— 避免手指抖动误改速度
    if (!drag.moved) {
      if (Math.abs(drag.accum) < 3) return;
      drag.moved = true;
    }

    const deltaBpm = drag.accum / 360 * DRAG_BPM_PER_TURN;
    setBpm(Math.round(drag.start + deltaBpm));

    e.preventDefault();
  }

  function onUp(e) {
    if (!drag) return;
    const wasDrag = drag.moved;
    drag = null;
    try { el.ring.releasePointerCapture(e.pointerId); } catch (err) {}

    // 只是点了一下（没拖动）→ 当作播放/停止
    if (!wasDrag) {
      if (metro.playing) stopMetro(); else startMetro();
    }
  }

  /* ══════════════════════════════════════════════════════
     播放 / 停止

     没有单独的播放按钮 —— 点圆环任意位置（含圆心）即开始/停止。
     播放中通过数字变主色来表示状态。
     ══════════════════════════════════════════════════════ */

  function startMetro() {
    metro.onBeat = (index, kind) => highlightBeat(index, kind);
    metro.start();

    el.bpmValue.classList.add('playing');
    el.center.classList.add('playing');
    el.ring.setAttribute('aria-label', '节拍器运行中，点一下停止');
  }

  function stopMetro() {
    metro.stop();

    el.bpmValue.classList.remove('playing');
    el.center.classList.remove('playing');
    el.ring.setAttribute('aria-label', '节拍器已停止，点一下开始');
    clearBeatHighlight();
  }

  el.ring.addEventListener('pointerdown', onDown);
  el.ring.addEventListener('pointermove', onMove);
  el.ring.addEventListener('pointerup', onUp);
  el.ring.addEventListener('pointercancel', () => { drag = null; });

  // 空格键快捷开关（输入框里打字时不触发）
  document.addEventListener('keydown', (e) => {
    if (e.code !== 'Space') return;
    const tag = (e.target.tagName || '').toLowerCase();
    if (tag === 'input' || tag === 'textarea') return;
    if (editing) return;                              // 正在输入速度
    if (currentPage !== 'metro') return;
    if (el.meterSheet.classList.contains('open')) return;
    e.preventDefault();
    if (metro.playing) stopMetro(); else startMetro();
  });

  /* ══════════════════════════════════════════════════════
     切到后台时清掉高亮（播放不停 —— 用户可能就想让它响着）
     ══════════════════════════════════════════════════════ */

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) clearBeatHighlight();
  });

  /* ══════════════════════════════════════════════════════
     初始化
     ══════════════════════════════════════════════════════ */

  buildGrids();
  setMeter(4, 4);
  metro.setBpm(120);
  paintBpm();                 // 初始化时直接画，不能走 setBpm（值没变会跳过）
  el.ring.setAttribute('aria-label', '节拍器已停止，点一下开始');
  document.body.dataset.page = 'tuner';
  el.tabs.dataset.index = '0';

})();

</script>
<!-- /METRONOME-JS-INSERTED -->

</body>
</html>