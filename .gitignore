# ---------- 签名密钥（绝对不要提交到仓库！） ----------
*.jks
*.keystore
*.p12
tools/*.pem
tools/keystore/

# ---------- Android ----------
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/captures/
*.iml

# 构建产物：默认不提交（防止把本地的 APK 误传上去）
*.apk
*.aab

# 但是 web/download/ 下的 APK 是个例外：
# 那是给用户下载用的正式安装包，由 GitHub Actions 构建后自动提交，
# Netlify 发布它，用户才能从网站下载。所以必须允许提交。
!web/download/*.apk

# ---------- 系统 ----------
.DS_Store
Thumbs.db

# ---------- 编辑器 ----------
.vscode/
.idea/

# ---------- Netlify ----------
.netlify/

# ---------- 构建脚本的状态记录 ----------
tools/.build-state.json
tools/repo-report.txt
tools/.t_*.txt
tools/.both_test_out.txt

# ---------- Python 缓存 ----------
__pycache__/
*.pyc
*.pyo
